# --- LLM ---
# Profile from config/models.yaml (free, free-flash, demo...). Empty = default_profile.
MODEL_PROFILE=free
# Your Gemini API key from Google AI Studio goes in GOOGLE_API_KEY
GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Key for the "glm" profile (aitokentracker.tech proxy)
AITOKENTRACKER_API_KEY=

# --- n8n ---
N8N_BASE_URL=http://localhost:5678/webhook
N8N_SECRET=change-me-to-a-long-random-string

# --- MCP server ---
MCP_HOST=127.0.0.1
MCP_PORT=8001

# --- Jarvis API (used by the n8n evaluation workflow) ---
API_PORT=8002
# 0.0.0.0 if n8n runs in Docker (it then calls http://host.docker.internal:8002)
API_HOST=127.0.0.1

# --- Clef decision model (input guard), from Cloudflare Workers AI ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=

# --- Safety ---
# Master switch for sending email and creating/moving events. Each action is still
# approved by you in the chat (see config/guardrails.yaml). false = always blocked.
ALLOW_SIDE_EFFECTS=true
