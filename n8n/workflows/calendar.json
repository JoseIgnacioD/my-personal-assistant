      "parameters": {
        "jsCode": "// Turns any node error into the standard answer Jarvis understands.\nconst item = $input.first().json;\nconst raw = item.error;\nlet message = typeof raw === 'string' ? raw : (raw?.message || item.message || 'Unknown error');\nif (raw && typeof raw === 'object' && raw.description) message += ` (${raw.description})`;\nlet failedNode = 'n8n';\ntry { failedNode = $prevNode.name; } catch (e) {}\nreturn [{ json: { ok: false, data: null, error: `${failedNode}: ${message}` } }];"
      },
