        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const results = $input.first().json.results;\nconst city = $('Webhook').first().json.body.city;\nif (!results || !results.length) {\n  throw new Error(`City \"${city}\" not found`);\n}\nreturn [{ json: results[0] }];"
      },
      "id": "f5905850-98c2-469d-9ca8-fb35a5112ef1",
