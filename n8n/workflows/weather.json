        "url": "https://api.open-meteo.com/v1/forecast",
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "latitude",
              "value": "={{ $json.latitude }}"
            },
            {
              "name": "longitude",
              "value": "={{ $json.longitude }}"
            },
            {
              "name": "daily",
              "value": "temperature_2m_max,temperature_2m_min,precipitation_probability_max"
            },
            {
              "name": "timezone",
              "value": "auto"
            },
            {
              "name": "forecast_days",
              "value": "={{ $('Webhook').first().json.body.days || 3 }}"
            }
          ]
        }
      },
      "id": "87db0b98-7d77-498a-82e7-d10cb9f25455",
      "name": "Forecast",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const place = $('Check city').first().json;\nconst d = $input.first().json.daily;\nconst days = d.time.map((date, i) => ({\n  date,\n  max_c: d.temperature_2m_max[i],\n  min_c: d.temperature_2m_min[i],\n  rain_chance_pct: d.precipitation_probability_max[i]\n}));\nreturn [{ json: { ok: true, data: { city: place.name, country: place.country, days }, error: null } }];"
      },
      "id": "8d0291c6-fa76-47e0-8d34-83e4d3b01174",
